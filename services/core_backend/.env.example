# Core Backend environment variables
# Copy to .env and fill in values

NODE_ENV=development

# JWT signing secret (required — must NOT be an insecure default in production)
JWT_SECRET=change_me_to_a_long_random_secret

# Server port
PORT=3000
HOST=0.0.0.0

# PostgreSQL / CockroachDB connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=continuum
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# Set to 'false' only in dev to skip cert verification (insecure):
# DB_SSL_REJECT_UNAUTHORIZED=false
# Path to CA certificate for DB TLS:
# DB_CA_CERT_PATH=

# Kafka broker
KAFKA_BROKERS=localhost:9092

# Firebase Admin SDK (JSON key path or inline JSON)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# CORS — comma-separated list of allowed origins (empty = CORS disabled)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.continuum.in
