{
  "name": "continuum-core-backend",
  "version": "1.0.0",
  "description": "Core Backend REST API for Continuum ML Pipelines",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.73.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/../../tests"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/consumers/**",
      "!src/workers/**",
      "!src/adapters/**",
      "!src/server.js",
      "!src/db.js",
      "!src/services/upi_mandate.js",
      "!src/services/kafkaConsumer.js",
      "!src/services/metrics.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "coverageReporters": ["lcov", "text-summary"]
  }
}
