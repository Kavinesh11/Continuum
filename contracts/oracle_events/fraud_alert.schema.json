{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fraud_alert.v1",
  "title": "Fraud Alert Event",
  "description": "Published by DLQ monitor or claims scoring pipeline when suspicious activity is detected.",
  "type": "object",
  "required": ["alert_type", "triggered_at"],
  "properties": {
    "alert_type": { "type": "string" },
    "queue": { "type": "string" },
    "job_id": { "type": "string" },
    "job_data": { "type": "object" },
    "claim_id": { "type": "string" },
    "worker_id": { "type": "string" },
    "failed_at": { "type": "string" },
    "triggered_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
