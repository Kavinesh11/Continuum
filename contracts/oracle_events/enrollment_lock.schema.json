{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "enrollment_lock.v1",
  "title": "Enrollment Lock Event",
  "description": "Published by oracle_engine when forecast severity triggers zone enrollment freeze.",
  "type": "object",
  "required": ["event_id", "zone_id", "event_type", "locked_at", "expires_at"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "zone_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string" },
    "forecast_data": {
      "type": "object",
      "properties": {
        "severity": { "type": "string", "enum": ["red", "orange", "yellow"] },
        "probability": { "type": "number" }
      }
    },
    "locked_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
