{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "Continuum Overview",
  "uid": "continuum-overview",
  "tags": ["continuum", "slo"],
  "timezone": "Asia/Kolkata",
  "refresh": "30s",
  "panels": [
    {
      "title": "Payout Latency SLO (p95 < 7200s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(continuum_trigger_to_payout_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        },
        {
          "expr": "7200",
          "legendFormat": "SLA threshold"
        }
      ]
    },
    {
      "title": "Oracle Freshness Ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "oracle_poll_fresh_ratio",
          "legendFormat": "freshness"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Kafka Consumer Lag (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "continuum_kafka_consumer_lag_seconds",
          "legendFormat": "{{ topic }}"
        }
      ]
    },
    {
      "title": "Reserve Balance (INR)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "reserve_balance_inr",
          "legendFormat": "reserve"
        }
      ]
    },
    {
      "title": "DLQ Depth by Queue",
      "type": "bargauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "continuum_dlq_depth",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "title": "Active Enrollment Locks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "continuum_enrollment_lock_active_count",
          "legendFormat": "locks"
        }
      ]
    },
    {
      "title": "Payout SLA Breaches (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "increase(payout_sla_breach_total[1h])",
          "legendFormat": "breaches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Kafka Messages Processed (by topic)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(kafka_messages_total[5m])",
          "legendFormat": "{{ topic }} - {{ status }}"
        }
      ]
    },
    {
      "title": "Reserve Floor Breach Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "increase(continuum_reserve_floor_breach_total[1h])",
          "legendFormat": "breaches"
        }
      ]
    },
    {
      "title": "Trigger-to-Payout Latency Distribution",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(continuum_trigger_to_payout_seconds_bucket[5m])",
          "legendFormat": "{{ le }}",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "Weekly Premiums Collected (INR)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "increase(weekly_premiums_collected_inr[7d])",
          "legendFormat": "premiums"
        }
      ]
    },
    {
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "targets": [
        {
          "expr": "continuum_circuit_breaker_state",
          "legendFormat": "{{ adapter }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HALF_OPEN", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "title": "Zone Kill Switches Active",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "continuum_zone_kill_switch_active",
          "legendFormat": "{{ zone_id }}",
          "instant": true
        }
      ]
    },
    {
      "title": "Portfolio Daily Cap Utilization",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "continuum_portfolio_daily_disbursed / continuum_portfolio_daily_cap * 100",
          "legendFormat": "utilization %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "title": "Payouts Disbursed (rate/5m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 28 },
      "targets": [
        {
          "expr": "rate(payouts_disbursed_total_inr[5m])",
          "legendFormat": "INR/s"
        }
      ]
    }
  ]
}
