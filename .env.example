# Continuum — root-level environment variables
# Copy to .env and fill with real values.
# docker-compose.yml reads these via env_file or ${VAR} substitution.

# ─── Secrets (NEVER commit real values) ──────────────────────────────────────

# Google Gemini API key (used by rasa_assistant)
GEMINI_API_KEY=

# PayU API credentials (sandbox values for local dev)
PAYU_API_KEY=
PAYU_MANDATE_URL=http://localhost:9000

# JWT signing secret for core_backend auth
JWT_SECRET=change_me_to_a_long_random_secret

# Firebase Admin SDK path
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# KMS provider: local | aws | gcp (default: local for dev)
KMS_PROVIDER=local
AWS_KMS_KEY_ARN=
GCP_KMS_KEY_NAME=

# ─── Feature flags ───────────────────────────────────────────────────────────

# Master payout automation switch (default off in dev)
PAYOUT_AUTOMATION_ENABLED=false

# Global kill switch — blocks all automated payouts when true
PAYOUT_KILL_SWITCH=false

# Enrollment lock enforcement
ENROLLMENT_LOCK_ENFORCED=true

# ─── Infrastructure ──────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=continuum
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

CRDB_DSN=postgresql://root@localhost:26257/continuum?sslmode=disable

KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# ─── External adapters ───────────────────────────────────────────────────────
# Each adapter reads <NAME>_PROVIDER to choose mock/sandbox/prod

PAYOUT_GATEWAY_PROVIDER=mock
MANDATE_GATEWAY_PROVIDER=mock
PLATFORM_VERIFIER_PROVIDER=mock
LIVENESS_PROVIDER=mock
WEATHER_HISTORICAL_PROVIDER=mock
ZONE_POLYGON_PROVIDER=mock
