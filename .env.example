# Continuum — root-level environment variables
# Copy to .env and fill with real values.
# docker-compose.yml reads these via env_file or ${VAR} substitution.

# ─── Secrets (NEVER commit real values) ──────────────────────────────────────

# Google Gemini API key (used by rasa_assistant and crew_ai)
GEMINI_API_KEY=

# PayU API credentials (sandbox values for local dev)
PAYU_API_KEY=
PAYU_MANDATE_URL=http://localhost:9000

# JWT signing secret for core_backend auth
JWT_SECRET=change_me_to_a_long_random_secret

# Firebase Admin SDK path
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# KMS provider: local | aws (default: local for dev)
KMS_PROVIDER=local
AWS_KMS_KEY_ARN=

# ─── Feature flags ───────────────────────────────────────────────────────────

# Master payout automation switch (default off in dev)
PAYOUT_AUTOMATION_ENABLED=false

# Global kill switch — blocks all automated payouts when true
PAYOUT_KILL_SWITCH=false

# Enrollment lock enforcement
ENROLLMENT_LOCK_ENFORCED=true

# ─── Infrastructure ──────────────────────────────────────────────────────────

# Used by docker-compose.yml for the postgres container AND core_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=continuum

NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=continuum
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false  # dev-only escape hatch
# DB_CA_CERT_PATH=                  # path to CA certificate for production TLS

CRDB_DSN=postgresql://root@localhost:26257/continuum?sslmode=disable

KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowed origins (empty = all cross-origin requests blocked)
# Development: include Flutter web (localhost:5000), Android emulator (10.0.2.2), and local dev server
# Production: set to the actual deployed frontend URL(s) only
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://10.0.2.2:3000

# ─── External adapters ───────────────────────────────────────────────────────
# Each adapter reads <NAME>_PROVIDER to choose mock/sandbox/prod

PAYOUT_GATEWAY_PROVIDER=mock
MANDATE_GATEWAY_PROVIDER=mock
PLATFORM_VERIFIER_PROVIDER=mock
LIVENESS_PROVIDER=mock
WEATHER_HISTORICAL_PROVIDER=mock
ZONE_POLYGON_PROVIDER=mock

# ─── Environment (prod / development) ────────────────────────────────────────
# Set to 'prod' to enable fail-closed TLS pinning and regulatory gates
CONTINUUM_ENV=development

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Replication factor for topic creation (1 for local, 3 for production)
KAFKA_REPLICATION_FACTOR=1

# ─── Oracle TLS cert pins (required when CONTINUUM_ENV=prod) ─────────────────
# SHA-256 fingerprints for certificate pinning — fail-closed in prod
IMD_CERT_FINGERPRINT=
IMD_CERT_FINGERPRINT_NEXT=
ACCUWEATHER_CERT_FINGERPRINT=
ACCUWEATHER_CERT_FINGERPRINT_NEXT=
NASA_GPM_CERT_FINGERPRINT=
NASA_GPM_CERT_FINGERPRINT_NEXT=
CPCB_CERT_FINGERPRINT=
CPCB_CERT_FINGERPRINT_NEXT=
DOWNDETECTOR_CERT_FINGERPRINT=
DOWNDETECTOR_CERT_FINGERPRINT_NEXT=
